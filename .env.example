# Copy to .env and change every value before deploying. Never commit .env.
DB_USERNAME=tulas
DB_PASSWORD=change-me-db-password
DB_ROOT_PASSWORD=change-me-root-password
# At least 32 random characters, e.g. from: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@tulascanteen.in
ADMIN_PASSWORD=change-me-strong-admin-password
# true adds a demo menu and demo logins (only for testing)
SEED_DEMO=false
CORS_ORIGINS=http://localhost:8080
